{
  "name": "galactic-syndicate",
  "private": true,
  "version": "0.2.0",
  "description": "Galactic Syndicate – 3D-Wirtschafts-, Automatisierungs- und Weltraum-Mafia-Simulation (Vite + TypeScript + Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/three": "0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
